{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "eFeFlow",
  "mainBinaryName": "eFeFlow",
  "version": "0.9.25",
  "identifier": "com.alegoriasoft.efeflow",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5183",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "eFeFlow",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 660,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "center": true,
        "visible": false,
        "dragDropEnabled": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Visual nftables firewall rule designer",
    "longDescription": "Design Linux nftables rulesets visually: import a live ruleset, edit it on a canvas laid out by netfilter hook and chain priority, catch shadowed rules and NAT conflicts, simulate a packet through the chains, and export clean nft source.",
    "linux": {
      "deb": {
        "recommends": ["nftables", "pkexec | policykit-1"],
        "files": {
          "/usr/libexec/efeflow/efeflow-nft-helper": "../packaging/linux/efeflow-nft-helper",
          "/usr/share/polkit-1/actions/com.alegoriasoft.efeflow.policy": "../packaging/linux/com.alegoriasoft.efeflow.policy"
        },
        "postInstallScript": "./scripts/postinstall.sh",
        "desktopTemplate": "./efeflow.desktop"
      },
      "rpm": {
        "recommends": ["nftables", "polkit"],
        "files": {
          "/usr/libexec/efeflow/efeflow-nft-helper": "../packaging/linux/efeflow-nft-helper",
          "/usr/share/polkit-1/actions/com.alegoriasoft.efeflow.policy": "../packaging/linux/com.alegoriasoft.efeflow.policy"
        },
        "postInstallScript": "./scripts/postinstall.sh",
        "desktopTemplate": "./efeflow.desktop"
      }
    }
  }
}
