# A ruleset planted with the defects the analyser is built to find.
# Lives here, in the tests, and not in the product: the application must
# never open on a firewall its user did not write.
#
#   input  rule 11  shadowed by rule 9
#   nat_pre         two DNAT rules, overlapping, divergent targets
#   input  5-8      differ only by port; @mgmt_ports already holds them
#   forward         trusts conntrack but never drops invalid
#   output rule 3   logs without a rate limit
#   @cdn_edges      declared, never referenced
#
# Every defect above is a design defect: this ruleset loads. nat_pre rule 2
# used to reach for @admin_nets, which lives in `inet fw` — a set is scoped to
# its table, so nft refused the whole file. The defects here are meant to be
# the analyser's to find, not nft's to reject.

flush ruleset

table inet fw {
	set admin_nets {
		type ipv4_addr ; flags interval
		elements = { 10.10.0.0/24, 10.10.4.0/24, 10.20.0.0/16, 192.168.88.0/24, 198.51.100.7/32, 203.0.113.0/28 }
	}

	set mgmt_ports {
		type inet_service
		elements = { 22, 443, 161, 8291 }
	}

	set vpn_peers {
		type ipv4_addr
		elements = { 10.44.0.2, 10.44.0.3, 10.44.0.4 }
	}

	set blocklist {
		type ipv4_addr ; flags interval, timeout
		elements = { /* 1 248 elements */ }
	}

	set cdn_edges {
		type ipv6_addr ; flags interval
		elements = { 2606:4700::/32, 2a02:26f0::/32, /* +36 more */ }
	}

	chain raw_pre {
		type filter hook prerouting priority -300 ; policy accept ;
		ip saddr @blocklist counter drop comment "Threat-feed drop, 24h timeout"
		ct state invalid counter drop
		meta iifname "wan0" ip saddr 10.0.0.0/8 counter drop comment "Anti-spoof: RFC1918 from WAN"
	}

	chain input {
		type filter hook input priority 0 ; policy drop ;
		ct state established,related counter accept
		iif lo counter accept
		ct state invalid counter drop
		meta l4proto { icmp, ipv6-icmp } limit rate 20/second counter accept
		tcp dport 22 ip saddr @admin_nets counter accept comment "Management plane"
		tcp dport 443 ip saddr @admin_nets counter accept
		tcp dport 8291 ip saddr @admin_nets counter accept
		tcp dport 161 ip saddr @admin_nets counter accept
		tcp dport { 80, 443 } counter accept
		udp dport 51820 counter accept comment "WireGuard"
		ip saddr 10.10.0.0/24 tcp dport 443 accept
		limit rate 5/second log prefix "fw-input-drop " counter drop
	}

	chain forward {
		type filter hook forward priority 0 ; policy drop ;
		ct state established,related counter accept
		ct status dnat counter accept comment "Allow translated flows"
		iifname "br-lan" oifname "wan0" counter accept
		iifname "wg0" ip saddr @vpn_peers counter jump fwd_mgmt
		iifname "vlan30" oifname "br-lan" counter reject with icmpx admin-prohibited comment "IoT stays isolated"
		iifname "docker0" counter accept
		log prefix "fw-fwd-drop " limit rate 5/second counter drop
	}

	chain fwd_mgmt {
		tcp dport @mgmt_ports counter accept
		counter drop
	}

	chain output {
		type filter hook output priority 0 ; policy accept ;
		ct state established,related counter accept
		oif lo counter accept
		ip daddr @blocklist log prefix "egress-block " counter drop
	}
}

table ip nat {
	chain nat_pre {
		type nat hook prerouting priority -100 ; policy accept ;
		iifname "wan0" tcp dport 8443 counter dnat to 10.20.0.15:443 comment "Ingress controller"
		ip saddr 198.51.100.0/24 tcp dport 8443 dnat to 10.20.0.31:443 comment "Staging ingress"
		iifname "wan0" udp dport 51820 accept comment "WireGuard, no translation"
	}

	chain nat_post {
		type nat hook postrouting priority 100 ; policy accept ;
		oifname "wan0" ip saddr 10.10.0.0/24 counter masquerade
		oifname "wan0" ip saddr 172.17.0.0/16 counter masquerade
	}
}
