{
  "name": "efeflow",
  "version": "0.9.10",
  "private": true,
  "description": "Visual nftables firewall rule designer",
  "author": "eFeSpain",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/eFeSpain/efeflow.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test \"test/*.test.js\"",
    "differ": "node scripts/differ.mjs",
    "oracle": "node scripts/oracle.mjs",
    "tauri": "tauri",
    "app": "tauri dev",
    "app:build": "tauri build",
    "icons": "tauri icon assets/app.png",
    "shots": "node scripts/shots.mjs",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "rust:check": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check && cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "gifs": "node scripts/gifs.mjs",
    "e2e": "node --test test/e2e/app.e2e.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-fs": "^2.0.0"
  },
  "bin": {
    "efeflow": "./bin/efeflow.mjs"
  },
  "files": [
    "bin",
    "src",
    "index.html",
    "public"
  ]
}
