node_modules/
dist/
dist-ssr/
*.local

src-tauri/target/
src-tauri/gen/

# `tauri::generate_context!()` opens the icons at compile time, so they are an
# input to `cargo check` and not just to the bundler. Everything the desktop
# build reads is committed, .icns included. Only the mobile sets that
# `npm run icons` also emits are left out — nothing here targets them.
src-tauri/icons/android/
src-tauri/icons/ios/

.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# left behind only if the GIF recorder crashes mid-run
.gif-tmp/

# scratch harnesses: dotfiles are not covered by the rules above, and one
# swept eight of them into a commit along with the address of a test machine
.*.mjs
.vm*

# Other people's rulesets, fetched for testing. Not ours to commit.
.corpus/

# Local Claude Code settings — machine-specific, never shared
.claude/settings.local.json
